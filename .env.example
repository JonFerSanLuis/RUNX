# Copia este archivo como .env y completa solo tus credenciales locales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=running_store
DB_USER=root
DB_PASSWORD=

# Configuración de correo y SMTP transaccional
APP_URL=http://localhost/RUNX
ADMIN_EMAIL=admin@runx.test
MAIL_FROM_ADDRESS=no-reply@runx.test
MAIL_FROM_NAME=BRAND NAME
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls

# Pasarela de pagos con tarjeta (Stripe)
# Registrate gratis en https://dashboard.stripe.com/register para obtener claves de prueba
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
